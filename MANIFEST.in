include CITATION.cff CHANGELOG.md CONTRIBUTING.md
recursive-include docs *.md *.png
prune examples
prune benchmark-data
prune benchmark-runs
recursive-include scripts *.py *.sh
prune .mathagent
global-exclude .env .env.* *.pem *.key
recursive-include mathagent/gui/static *
recursive-include mathagent/skills *.md
recursive-include mathagent/numerics/docker Dockerfile *.py *.in *.lock LICENSE.md LICENSE-APACHE-2.0 NOTICE
include frontend/package.json frontend/package-lock.json frontend/tsconfig.json frontend/tsconfig.tests.json frontend/vite.config.ts frontend/index.html
recursive-include frontend/src *
recursive-include frontend/public *
recursive-include frontend/scripts *.mjs
recursive-include frontend/tests *.ts
prune frontend/node_modules
recursive-include deployment *.py *.json Dockerfile*
